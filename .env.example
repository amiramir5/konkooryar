# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional, public API origin used by the native Android app for AI endpoints.
# Must be an HTTPS URL for your separately deployed server.ts backend.
# Never put GEMINI_API_KEY or other secrets in a VITE_ variable.
VITE_API_BASE_URL="https://your-backend.example.com"

# Comma-separated frontend origins allowed to call the API. Include https://localhost
# for Capacitor Android; add your production website origin if it is hosted separately.
API_ALLOWED_ORIGINS="https://localhost,capacitor://localhost,http://localhost:5173"

# Enable only when deployed behind a trusted reverse proxy (e.g. Render).
TRUST_PROXY="true"
